# Copy to backend/.env. Never put service-role credentials in frontend files.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Arize AX is the selected evaluation AND observability platform.
# Use the accessible Arize Space ID (Default Space for the current project).
# Keys and telemetry configuration remain server-side; Galileo is retired.
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=cfin-document-error-analysis
ARIZE_API_URL=https://api.arize.com/v2
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces
# Uvicorn proxy trust defaults to loopback. In production set only the actual trusted ingress IPs/networks.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Keep factual and Error Analysis intake/dispatch off until their additive migrations
# and cloud isolation checks pass.
LOG_ONLY_ENABLED=false
# Paid execution has a separate gate and bounded budgets.
PAID_MODELS_ENABLED=false
# Agreed baseline: Luna for extraction; Sol for Error Analysis and Summary.
# New jobs pin their workflow version; existing legacy and factual jobs retain their contracts.
MODEL_AGENT_1=gpt-6-luna
MODEL_AGENT_2=gpt-6.1-sol
MODEL_AGENT_3=gpt-6.1-sol
# Empty uses the Sol backlog-analysis baseline; effort is shared below.
MODEL_AGENT_4=
MODEL_REASONING_EFFORT=medium
# New intakes only: baseline, compact (medium reasoning), or experimental fast,
# writer_luna, writer_low, all_luna. Experiments preserve the compact layout/prompts.
ERROR_ANALYSIS_PROFILE=baseline
MODEL_MONTHLY_BUDGET_USD=10.00
MODEL_RUN_BUDGET_USD=1.00
STAGE_TIMEOUT_SECONDS=60
STAGE_MAX_RETRIES=1

# Optional localhost-only persona walkthrough. Use an existing synthetic workspace
# and test account with all four walkthrough roles. Never enable for public hosting.
LOCAL_DEMO_ENABLED=false
# DEMO_WORKSPACE_ID=<synthetic-workspace-uuid>
# DEMO_ACTOR_ID=<existing-test-user-uuid>

# Optional administrative connection for migrations; never exposed to the browser.
# DATABASE_URL=postgresql://<database-user>:<url-encoded-password>@<database-host>:5432/postgres
