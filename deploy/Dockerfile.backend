FROM ghcr.io/astral-sh/uv:0.8.22 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src ./src
COPY fixtures /app/fixtures
COPY evals/log-only-expectations.json /app/evals/log-only-expectations.json
RUN uv sync --frozen --no-dev
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONPATH=/app/backend/src PYTHONUNBUFFERED=1
RUN useradd --create-home app && chown -R app:app /app
USER app
CMD ["sh", "-c", "exec uvicorn cfin.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
