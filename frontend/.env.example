# Browser-safe Supabase project URL and publishable key (legacy anon key also works).
# Never place a service-role or secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI origin. Add this portal's origin to the backend CORS allowlist.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Connect the existing persona demo to a loopback API with LOCAL_DEMO_ENABLED=true.
NEXT_PUBLIC_WORKBENCH_CONNECTED=false
